<div class="sanoozy-account--narrow">
  {% render 'account-logo' %}

  <div id="recover"></div>

  <div class="sanoozy-account-card sanoozy-account-login">
    <h1>Sign in</h1>
    <p>Welcome back to Sanoozy. Sign in to view your orders and profile.</p>

    {%- form 'customer_login', novalidate: 'novalidate', class: 'sanoozy-account-form' -%}
      {%- if form.errors -%}
        <div class="sanoozy-account-alert sanoozy-account-alert--error">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <label class="sanoozy-account-field">
        <span>Email</span>
        <input
          type="email"
          name="customer[email]"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          required
          value="{{ form.email }}"
          placeholder="you@email.com"
        >
      </label>

      {%- if form.password_needed -%}
        <label class="sanoozy-account-field">
          <span>Password</span>
          <input
            type="password"
            name="customer[password]"
            autocomplete="current-password"
            required
            placeholder="Your password"
          >
        </label>
      {%- endif -%}

      <button type="submit" class="button">Sign in</button>

      <div class="sanoozy-account-links">
        {%- if form.password_needed -%}
          <a href="#recover">Forgot your password?</a>
        {%- endif -%}
        <a href="{{ routes.account_register_url }}">Create an account</a>
      </div>
    {%- endform -%}
  </div>

  <div class="sanoozy-account-card sanoozy-account-recover">
    <h1>Reset password</h1>
    <p>Enter your email and we’ll send you a reset link.</p>

    {%- form 'recover_customer_password', class: 'sanoozy-account-form' -%}
      {%- if form.errors -%}
        <div class="sanoozy-account-alert sanoozy-account-alert--error">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      {%- assign recover_success = form.posted_successfully? -%}
      {%- if recover_success -%}
        <div class="sanoozy-account-alert sanoozy-account-alert--success">
          We’ve sent you an email with a link to update your password.
        </div>
      {%- endif -%}

      <label class="sanoozy-account-field">
        <span>Email</span>
        <input
          type="email"
          name="email"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          required
          value="{{ form.email }}"
          placeholder="you@email.com"
        >
      </label>

      <button type="submit" class="button">Send reset link</button>
      <div class="sanoozy-account-links">
        <a href="#login">Back to sign in</a>
      </div>
    {%- endform -%}
  </div>

  {%- if cart != empty -%}
    <div class="sanoozy-account-card" style="margin-block-start: 18px;">
      <h1>Guest checkout</h1>
      <p>Continue without creating an account.</p>
      {%- form 'guest_login', class: 'sanoozy-account-form' -%}
        <button type="submit" class="button-secondary">Continue as guest</button>
      {%- endform -%}
    </div>
  {%- endif -%}
</div>
