{%- doc -%}
  Hardcoded footer navigation links for Useful Links and Our Policies.
  @param {string} menu_type - "useful" or "policies"
  @param {string} [link_preset] - Typography preset class for menu items
{%- enddoc -%}

{%- liquid
  assign cancel_order_url = pages['cancel-order'].url
  if cancel_order_url == blank
    assign cancel_order_url = '/pages/cancel-order'
  endif

  assign contact_info_url = pages['contact-information'].url
  if contact_info_url == blank
    assign contact_info_url = '/pages/contact-information'
  endif

  assign privacy_url = pages['privacy-policy'].url
  if privacy_url == blank
    assign privacy_url = '/pages/privacy-policy'
  endif

  assign shipping_url = pages['shipping-policy'].url
  if shipping_url == blank
    assign shipping_url = '/pages/shipping-policy'
  endif

  assign refund_url = pages['refund-policy'].url
  if refund_url == blank
    assign refund_url = '/pages/refund-policy'
  endif

  assign terms_url = pages['terms-of-service'].url
  if terms_url == blank
    assign terms_url = '/pages/terms-of-service'
  endif
-%}

<ul class="list-unstyled">
  {%- if menu_type == 'useful' -%}
    <li class="menu__item {{ link_preset }}">
      <a href="{{ routes.all_products_collection_url }}">Buy Now</a>
    </li>
    <li class="menu__item {{ link_preset }}">
      <a href="{{ routes.account_url }}">My Profile</a>
    </li>
    <li class="menu__item {{ link_preset }}">
      <a href="{{ routes.account_url }}">My Orders</a>
    </li>
    <li class="menu__item {{ link_preset }}">
      <a href="{{ routes.account_url }}">Track Order</a>
    </li>
    <li class="menu__item {{ link_preset }}">
      <a href="{{ cancel_order_url }}">Cancel Order</a>
    </li>
  {%- elsif menu_type == 'policies' -%}
    <li class="menu__item {{ link_preset }}">
      <a href="{{ privacy_url }}">Privacy Policy</a>
    </li>
    <li class="menu__item {{ link_preset }}">
      <a href="{{ shipping_url }}">Shipping Policy</a>
    </li>
    <li class="menu__item {{ link_preset }}">
      <a href="{{ refund_url }}">Refund Policy</a>
    </li>
    <li class="menu__item {{ link_preset }}">
      <a href="{{ terms_url }}">Terms of Service</a>
    </li>
    <li class="menu__item {{ link_preset }}">
      <a href="{{ contact_info_url }}">Contact Information</a>
    </li>
  {%- endif -%}
</ul>
