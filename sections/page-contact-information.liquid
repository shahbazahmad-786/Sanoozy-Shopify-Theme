{%- liquid
  assign whatsapp_url = 'https://wa.me/923148232224?text=Hey%20Sanoozy%21%20I%20have%20a%20question.'
  assign email_address = 'contact.sanoozy@gmail.com'
  assign form_id = 'ContactInformationForm'
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--page-width color-{{ section.settings.color_scheme }}">
  <div
    class="sanoozy-info-page spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <header class="sanoozy-info-hero">
      <p class="sanoozy-info-eyebrow">Get in touch</p>
      <h1 class="sanoozy-info-title">Contact Information</h1>
      <p class="sanoozy-info-lead">We’d love to hear from you!</p>
      <p class="sanoozy-info-intro">
        If you have any questions, feedback, or need support, feel free to reach out to us using the details below.
      </p>
    </header>

    <div class="sanoozy-info-cards">
      <article class="sanoozy-info-card">
        <div class="sanoozy-info-card__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </div>
        <h3 class="sanoozy-info-card__title">WhatsApp / Phone</h3>
        <a class="sanoozy-info-card__value" href="{{ whatsapp_url }}" target="_blank" rel="noopener">0314 8232224</a>
        <p class="sanoozy-info-card__text">Available for calls &amp; WhatsApp during normal business hours.</p>
        <a class="button sanoozy-info-card__button" href="{{ whatsapp_url }}" target="_blank" rel="noopener">Message on WhatsApp</a>
      </article>

      <article class="sanoozy-info-card">
        <div class="sanoozy-info-card__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-10 7L2 7"/>
          </svg>
        </div>
        <h3 class="sanoozy-info-card__title">Email</h3>
        <a class="sanoozy-info-card__value" href="mailto:{{ email_address }}">{{ email_address }}</a>
        <p class="sanoozy-info-card__text">
          For order queries, collaborations, or general questions, drop us an email and we’ll get back to you as soon as possible.
        </p>
        <a class="button-secondary sanoozy-info-card__button" href="mailto:{{ email_address }}">Send an email</a>
      </article>

      <article class="sanoozy-info-card">
        <div class="sanoozy-info-card__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
        </div>
        <h3 class="sanoozy-info-card__title">Physical Address</h3>
        <p class="sanoozy-info-card__value">Gulgasht Colony, Office</p>
        <p class="sanoozy-info-card__text">Multan 59300, Punjab, Pakistan</p>
        <p class="sanoozy-info-card__note">
          You can visit us during our working hours or contact us before visiting for any specific queries.
        </p>
      </article>
    </div>

    <section class="sanoozy-info-form-wrap" aria-labelledby="contact-form-heading">
      <div class="sanoozy-info-form-intro">
        <h2 id="contact-form-heading" class="sanoozy-info-panel__title">Send us a message</h2>
        <p>Share your question or feedback and we’ll reply as soon as we can.</p>
      </div>

      {%- form 'contact', id: form_id, class: 'sanoozy-info-form' -%}
        <input type="hidden" name="contact[id]" value="{{ form_id }}">

        {%- if form.errors and form.id == form_id -%}
          <div class="sanoozy-info-form__alert sanoozy-info-form__alert--error" tabindex="-1">
            Please check the highlighted fields and try again.
          </div>
        {%- endif -%}

        {%- if form.posted_successfully? and form.id == form_id -%}
          <div class="sanoozy-info-form__alert sanoozy-info-form__alert--success" tabindex="-1">
            Thank you for reaching out. We’ll get back to you as soon as possible.
          </div>
        {%- endif -%}

        <div class="sanoozy-info-form__grid">
          <label class="sanoozy-info-field">
            <span>Full name</span>
            <input
              type="text"
              name="contact[name]"
              autocomplete="name"
              required
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              placeholder="Your name"
            >
          </label>
          <label class="sanoozy-info-field">
            <span>Email</span>
            <input
              type="email"
              name="contact[email]"
              autocomplete="email"
              required
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              placeholder="you@email.com"
            >
          </label>
          <label class="sanoozy-info-field">
            <span>Phone</span>
            <input
              type="tel"
              name="contact[phone]"
              autocomplete="tel"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              placeholder="03XX XXXXXXX"
            >
          </label>
          <label class="sanoozy-info-field">
            <span>Subject</span>
            <input
              type="text"
              name="contact[subject]"
              placeholder="How can we help?"
            >
          </label>
        </div>
        <label class="sanoozy-info-field">
          <span>Message</span>
          <textarea
            name="contact[body]"
            rows="6"
            required
            placeholder="Write your message here"
          >{{ form.body }}</textarea>
        </label>
        <button type="submit" class="button">Send message</button>
      {%- endform -%}
    </section>

    <aside class="sanoozy-info-assist">
      <h2>Stay connected</h2>
      <p>
        Have a question about a product? Reach out anytime — we’re here to help you look your best with Sanoozy.
      </p>
      <a class="button" href="{{ whatsapp_url }}" target="_blank" rel="noopener">Chat with us</a>
    </aside>
  </div>
</div>

{% stylesheet %}
  .sanoozy-info-page {
    width: 100%;
    max-width: 1080px;
    margin-inline: auto;
  }

  .sanoozy-info-hero {
    text-align: center;
    max-width: 720px;
    margin-inline: auto;
    margin-block-end: 40px;
  }

  .sanoozy-info-eyebrow {
    margin: 0 0 10px;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    opacity: 0.7;
  }

  .sanoozy-info-title {
    margin: 0 0 12px;
  }

  .sanoozy-info-lead {
    margin: 0 0 12px;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .sanoozy-info-intro {
    margin: 0;
    opacity: 0.85;
    line-height: 1.6;
  }

  .sanoozy-info-panel__title {
    margin: 0 0 12px;
    font-size: 1.25rem;
  }

  .sanoozy-info-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    margin-block-end: 36px;
  }

  .sanoozy-info-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-radius: 18px;
    background: rgb(var(--color-foreground-rgb) / 0.03);
    min-height: 100%;
  }

  .sanoozy-info-card__icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: rgb(var(--color-foreground-rgb) / 0.08);
    color: var(--color-foreground);
  }

  .sanoozy-info-card__title {
    margin: 4px 0 0;
    font-size: 1.05rem;
  }

  .sanoozy-info-card__value {
    margin: 0;
    font-weight: 700;
    font-size: 1.05rem;
    color: inherit;
    text-decoration: none;
    word-break: break-word;
  }

  .sanoozy-info-card__value:hover {
    text-decoration: underline;
  }

  .sanoozy-info-card__text,
  .sanoozy-info-card__note {
    margin: 0;
    line-height: 1.55;
    opacity: 0.85;
  }

  .sanoozy-info-card__note {
    font-size: 0.92rem;
  }

  .sanoozy-info-card__button {
    margin-block-start: auto;
    padding-block: 12px;
    padding-inline: 18px;
  }

  .sanoozy-info-form-wrap {
    padding: 32px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-radius: 18px;
    background: rgb(var(--color-foreground-rgb) / 0.03);
    margin-block-end: 28px;
  }

  .sanoozy-info-form-intro {
    margin-block-end: 24px;
  }

  .sanoozy-info-form-intro p {
    margin: 0;
    opacity: 0.85;
  }

  .sanoozy-info-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .sanoozy-info-form__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .sanoozy-info-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .sanoozy-info-field input,
  .sanoozy-info-field textarea {
    width: 100%;
    font-weight: 400;
    color: var(--color-input-text);
    background-color: var(--color-input-background);
    border: var(--style-border-width-inputs) solid var(--color-input-border);
    border-radius: var(--style-border-radius-inputs);
    padding: 14px 16px;
  }

  .sanoozy-info-form__alert {
    padding: 14px 16px;
    border-radius: 12px;
    font-size: 0.95rem;
  }

  .sanoozy-info-form__alert--success {
    background: rgb(47 122 62 / 0.12);
  }

  .sanoozy-info-form__alert--error {
    background: rgb(180 50 50 / 0.12);
  }

  .sanoozy-info-assist {
    text-align: center;
    padding: 36px 28px;
    border-radius: 18px;
    background: rgb(var(--color-foreground-rgb) / 0.07);
  }

  .sanoozy-info-assist h2 {
    margin: 0 0 10px;
    font-size: 1.4rem;
  }

  .sanoozy-info-assist p {
    margin: 0 auto 20px;
    max-width: 640px;
    line-height: 1.6;
    opacity: 0.85;
  }

  .sanoozy-info-assist .button {
    margin-inline: auto;
    padding-block: 12px;
    padding-inline: 22px;
  }

  @media screen and (min-width: 750px) {
    .sanoozy-info-cards {
      grid-template-columns: repeat(3, 1fr);
    }

    .sanoozy-info-form__grid {
      grid-template-columns: 1fr 1fr;
    }

    .sanoozy-info-hero {
      margin-block-end: 48px;
    }
  }

  @media screen and (max-width: 749px) {
    .sanoozy-info-form-wrap {
      padding: 22px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact information page",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
