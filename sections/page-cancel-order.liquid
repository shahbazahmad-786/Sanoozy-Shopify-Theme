{%- liquid
  assign whatsapp_url = 'https://wa.me/923148232224?text=Hi%20Sanoozy%2C%20I%20would%20like%20to%20cancel%20my%20order.%20Order%20number%3A%20'
  assign email_address = 'contact.sanoozy@gmail.com'

  assign refund_url = pages['refund-policy'].url
  if refund_url == blank
    assign refund_url = '/pages/refund-policy'
  endif

  assign form_id = 'CancelOrderForm'
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--page-width color-{{ section.settings.color_scheme }}">
  <div
    class="sanoozy-info-page spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <header class="sanoozy-info-hero">
      <p class="sanoozy-info-eyebrow">Order support</p>
      <h1 class="sanoozy-info-title">Cancel Order</h1>
      <p class="sanoozy-info-lead">We’re here to help you with your order.</p>
      <p class="sanoozy-info-intro">
        If you would like to cancel your order, please review the information below and contact us as soon as possible.
      </p>
    </header>

    <section class="sanoozy-info-panel" aria-labelledby="cancel-policy-heading">
      <div class="sanoozy-info-panel__icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 8V21H3V8"/>
          <path d="M1 3h22v5H1z"/>
          <path d="M10 12h4"/>
        </svg>
      </div>
      <div class="sanoozy-info-panel__body">
        <h2 id="cancel-policy-heading" class="sanoozy-info-panel__title">Order Cancellation Policy</h2>
        <ul class="sanoozy-info-list">
          <li>Orders can only be cancelled before they are shipped.</li>
          <li>Once the order has been dispatched, cancellation is no longer possible.</li>
          <li>
            If your order has already been shipped, you may refer to our
            <a href="{{ refund_url }}">Return Policy</a> (if applicable).
          </li>
          <li>We recommend contacting us immediately after placing the order if you wish to cancel.</li>
        </ul>
      </div>
    </section>

    <div class="sanoozy-info-cards">
      <article class="sanoozy-info-card">
        <div class="sanoozy-info-card__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </div>
        <h3 class="sanoozy-info-card__title">WhatsApp / Phone</h3>
        <a class="sanoozy-info-card__value" href="{{ whatsapp_url }}" target="_blank" rel="noopener">0314 8232224</a>
        <p class="sanoozy-info-card__text">Available for calls &amp; WhatsApp during normal business hours.</p>
        <p class="sanoozy-info-card__note">For faster processing, please share:</p>
        <ul class="sanoozy-info-mini-list">
          <li>Your Order Number</li>
          <li>Your Full Name</li>
          <li>Reason for cancellation</li>
        </ul>
        <a class="button sanoozy-info-card__button" href="{{ whatsapp_url }}" target="_blank" rel="noopener">Message on WhatsApp</a>
      </article>

      <article class="sanoozy-info-card">
        <div class="sanoozy-info-card__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-10 7L2 7"/>
          </svg>
        </div>
        <h3 class="sanoozy-info-card__title">Email</h3>
        <a class="sanoozy-info-card__value" href="mailto:{{ email_address }}">{{ email_address }}</a>
        <p class="sanoozy-info-card__text">For order cancellation requests, please include:</p>
        <ul class="sanoozy-info-mini-list">
          <li>Order Number</li>
          <li>Name used for the order</li>
          <li>Contact number</li>
          <li>Reason for cancellation</li>
        </ul>
        <p class="sanoozy-info-card__note">We aim to respond as quickly as possible.</p>
        <a class="button-secondary sanoozy-info-card__button" href="mailto:{{ email_address }}?subject=Order%20Cancellation%20Request">Send an email</a>
      </article>

      <article class="sanoozy-info-card">
        <div class="sanoozy-info-card__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
        </div>
        <h3 class="sanoozy-info-card__title">Physical Address</h3>
        <p class="sanoozy-info-card__value">Gulgasht Colony, Office</p>
        <p class="sanoozy-info-card__text">Multan 59300, Punjab, Pakistan</p>
        <p class="sanoozy-info-card__note">You may contact us before visiting regarding any order concerns.</p>
      </article>
    </div>

    <section class="sanoozy-info-form-wrap" aria-labelledby="cancel-form-heading">
      <div class="sanoozy-info-form-intro">
        <h2 id="cancel-form-heading" class="sanoozy-info-panel__title">Request a cancellation</h2>
        <p>Fill in the form below and our team will get back to you as soon as possible.</p>
      </div>

      {%- form 'contact', id: form_id, class: 'sanoozy-info-form' -%}
        <input type="hidden" name="contact[id]" value="{{ form_id }}">
        <input type="hidden" name="contact[request_type]" value="Order Cancellation">

        {%- if form.errors and form.id == form_id -%}
          <div class="sanoozy-info-form__alert sanoozy-info-form__alert--error" tabindex="-1">
            Please check the highlighted fields and try again.
          </div>
        {%- endif -%}

        {%- if form.posted_successfully? and form.id == form_id -%}
          <div class="sanoozy-info-form__alert sanoozy-info-form__alert--success" tabindex="-1">
            Thank you. Your cancellation request has been received. We’ll contact you shortly.
          </div>
        {%- endif -%}

        <div class="sanoozy-info-form__grid">
          <label class="sanoozy-info-field">
            <span>Full name</span>
            <input
              type="text"
              name="contact[name]"
              autocomplete="name"
              required
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              placeholder="Name used for the order"
            >
          </label>
          <label class="sanoozy-info-field">
            <span>Email</span>
            <input
              type="email"
              name="contact[email]"
              autocomplete="email"
              required
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              placeholder="you@email.com"
            >
          </label>
          <label class="sanoozy-info-field">
            <span>Contact number</span>
            <input
              type="tel"
              name="contact[phone]"
              autocomplete="tel"
              required
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              placeholder="03XX XXXXXXX"
            >
          </label>
          <label class="sanoozy-info-field">
            <span>Order number</span>
            <input
              type="text"
              name="contact[order_number]"
              required
              placeholder="e.g. #1001"
            >
          </label>
        </div>
        <label class="sanoozy-info-field">
          <span>Reason for cancellation</span>
          <textarea
            name="contact[body]"
            rows="5"
            required
            placeholder="Tell us why you’d like to cancel this order"
          >{{ form.body }}</textarea>
        </label>
        <button type="submit" class="button">Submit cancellation request</button>
      {%- endform -%}
    </section>

    <aside class="sanoozy-info-assist">
      <h2>Need assistance?</h2>
      <p>
        Have a question about your order status, size change, or product details?
        Reach out anytime — we’re here to make your experience smooth and hassle-free with Sanoozy.
      </p>
      <a class="button" href="{{ whatsapp_url }}" target="_blank" rel="noopener">Chat with us</a>
    </aside>
  </div>
</div>

{% stylesheet %}
  .sanoozy-info-page {
    width: 100%;
    max-width: 1080px;
    margin-inline: auto;
  }

  .sanoozy-info-hero {
    text-align: center;
    max-width: 720px;
    margin-inline: auto;
    margin-block-end: 40px;
  }

  .sanoozy-info-eyebrow {
    margin: 0 0 10px;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    opacity: 0.7;
  }

  .sanoozy-info-title {
    margin: 0 0 12px;
  }

  .sanoozy-info-lead {
    margin: 0 0 12px;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .sanoozy-info-intro {
    margin: 0;
    opacity: 0.85;
    line-height: 1.6;
  }

  .sanoozy-info-panel {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    padding: 28px 32px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-radius: 18px;
    background: rgb(var(--color-foreground-rgb) / 0.04);
    margin-block-end: 28px;
  }

  .sanoozy-info-panel__icon,
  .sanoozy-info-card__icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: rgb(var(--color-foreground-rgb) / 0.08);
    color: var(--color-foreground);
  }

  .sanoozy-info-panel__title {
    margin: 0 0 12px;
    font-size: 1.25rem;
  }

  .sanoozy-info-list,
  .sanoozy-info-mini-list {
    margin: 0;
    padding-inline-start: 18px;
  }

  .sanoozy-info-list li + li,
  .sanoozy-info-mini-list li + li {
    margin-block-start: 8px;
  }

  .sanoozy-info-list a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sanoozy-info-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    margin-block-end: 36px;
  }

  .sanoozy-info-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-radius: 18px;
    background: rgb(var(--color-foreground-rgb) / 0.03);
    min-height: 100%;
  }

  .sanoozy-info-card__title {
    margin: 4px 0 0;
    font-size: 1.05rem;
  }

  .sanoozy-info-card__value {
    margin: 0;
    font-weight: 700;
    font-size: 1.05rem;
    color: inherit;
    text-decoration: none;
    word-break: break-word;
  }

  .sanoozy-info-card__value:hover {
    text-decoration: underline;
  }

  .sanoozy-info-card__text,
  .sanoozy-info-card__note {
    margin: 0;
    line-height: 1.55;
    opacity: 0.85;
  }

  .sanoozy-info-card__note {
    font-size: 0.92rem;
  }

  .sanoozy-info-card__button {
    margin-block-start: auto;
    padding-block: 12px;
    padding-inline: 18px;
  }

  .sanoozy-info-form-wrap {
    padding: 32px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-radius: 18px;
    background: rgb(var(--color-foreground-rgb) / 0.03);
    margin-block-end: 28px;
  }

  .sanoozy-info-form-intro {
    margin-block-end: 24px;
  }

  .sanoozy-info-form-intro p {
    margin: 0;
    opacity: 0.85;
  }

  .sanoozy-info-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .sanoozy-info-form__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .sanoozy-info-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .sanoozy-info-field input,
  .sanoozy-info-field textarea {
    width: 100%;
    font-weight: 400;
    color: var(--color-input-text);
    background-color: var(--color-input-background);
    border: var(--style-border-width-inputs) solid var(--color-input-border);
    border-radius: var(--style-border-radius-inputs);
    padding: 14px 16px;
  }

  .sanoozy-info-form__alert {
    padding: 14px 16px;
    border-radius: 12px;
    font-size: 0.95rem;
  }

  .sanoozy-info-form__alert--success {
    background: rgb(47 122 62 / 0.12);
  }

  .sanoozy-info-form__alert--error {
    background: rgb(180 50 50 / 0.12);
  }

  .sanoozy-info-assist {
    text-align: center;
    padding: 36px 28px;
    border-radius: 18px;
    background: rgb(var(--color-foreground-rgb) / 0.07);
  }

  .sanoozy-info-assist h2 {
    margin: 0 0 10px;
    font-size: 1.4rem;
  }

  .sanoozy-info-assist p {
    margin: 0 auto 20px;
    max-width: 640px;
    line-height: 1.6;
    opacity: 0.85;
  }

  .sanoozy-info-assist .button {
    margin-inline: auto;
    padding-block: 12px;
    padding-inline: 22px;
  }

  @media screen and (min-width: 750px) {
    .sanoozy-info-cards {
      grid-template-columns: repeat(3, 1fr);
    }

    .sanoozy-info-form__grid {
      grid-template-columns: 1fr 1fr;
    }

    .sanoozy-info-hero {
      margin-block-end: 48px;
    }
  }

  @media screen and (max-width: 749px) {
    .sanoozy-info-panel,
    .sanoozy-info-form-wrap {
      flex-direction: column;
      padding: 22px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cancel order page",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
