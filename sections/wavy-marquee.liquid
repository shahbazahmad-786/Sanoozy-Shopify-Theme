{% comment %} Wave Marquee Section — Shopify {% endcomment %}

<style>
  #marquee-{{ section.id }} {
    width: 100%;
    overflow: hidden;
    background: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    border-top: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
    border-bottom: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
  }

  #marquee-track-{{ section.id }} {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  #marquee-{{ section.id }} .mq-item {
    display: inline-flex;
    align-items: center;
    gap: {{ section.settings.item_gap }}px;
    padding: 0 {{ section.settings.item_gap }}px;
    white-space: nowrap;
    font-size: {{ section.settings.font_size }}px;
    font-weight: {{ section.settings.font_weight }};
    color: {{ section.settings.text_color }};
    text-transform: {{ section.settings.text_transform }};
    will-change: transform;
  }

  #marquee-{{ section.id }} .mq-item a {
    color: inherit;
    text-decoration: none;
  }

  #marquee-{{ section.id }} .mq-item a:hover {
    opacity: 0.7;
  }

  #marquee-{{ section.id }} .mq-sep {
    color: {{ section.settings.separator_color }};
    font-size: {{ section.settings.separator_size }}px;
    flex-shrink: 0;
  }

  #marquee-{{ section.id }} .mq-item img {
    height: {{ section.settings.icon_size }}px;
    width: auto;
    object-fit: contain;
    vertical-align: middle;
  }

  @media (prefers-reduced-motion: reduce) {
    #marquee-track-{{ section.id }} { animation: none !important; }
    #marquee-{{ section.id }} .mq-item { transform: none !important; }
  }
</style>

<div id="marquee-{{ section.id }}" aria-label="Announcements" role="marquee">
  <div id="marquee-track-{{ section.id }}">

    {% for block in section.blocks %}
      {% if block.type == 'text_item' %}
        <span class="mq-item" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <img src="{{ block.settings.icon | img_url: '100x' }}" alt="" aria-hidden="true">
          {% endif %}
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {% else %}
            {{ block.settings.text }}
          {% endif %}
        </span>
        <span class="mq-sep" aria-hidden="true">{{ section.settings.separator }}</span>
      {% elsif block.type == 'image_item' %}
        <span class="mq-item" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | img_url: '200x' }}" alt="{{ block.settings.image_alt | escape }}" loading="lazy">
          {% endif %}
        </span>
        <span class="mq-sep" aria-hidden="true">{{ section.settings.separator }}</span>
      {% endif %}
    {% endfor %}

    {% for block in section.blocks %}
      {% if block.type == 'text_item' %}
        <span class="mq-item" aria-hidden="true">
          {% if block.settings.icon != blank %}
            <img src="{{ block.settings.icon | img_url: '100x' }}" alt="">
          {% endif %}
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" tabindex="-1">{{ block.settings.text }}</a>
          {% else %}
            {{ block.settings.text }}
          {% endif %}
        </span>
        <span class="mq-sep" aria-hidden="true">{{ section.settings.separator }}</span>
      {% elsif block.type == 'image_item' %}
        <span class="mq-item" aria-hidden="true">
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | img_url: '200x' }}" alt="" loading="lazy">
          {% endif %}
        </span>
        <span class="mq-sep" aria-hidden="true">{{ section.settings.separator }}</span>
      {% endif %}
    {% endfor %}

  </div>
</div>

<script>
(function(){
  var wrap  = document.getElementById('marquee-{{ section.id }}');
  var track = document.getElementById('marquee-track-{{ section.id }}');
  if(!wrap || !track) return;

  var speed     = {{ section.settings.speed }};
  var waveAmp   = {{ section.settings.wave_amplitude }};
  var waveFreq  = {{ section.settings.wave_frequency }};
  var direction = '{{ section.settings.direction }}';
  var pauseHover= {{ section.settings.pause_on_hover }};

  var items  = track.querySelectorAll('.mq-item');
  var x      = 0;
  var t      = 0;
  var paused = false;
  var raf;

  if(pauseHover){
    wrap.addEventListener('mouseenter', function(){ paused = true; });
    wrap.addEventListener('mouseleave', function(){ paused = false; });
  }

  function tick(){
    if(!paused){
      t += 0.03;
      x += (direction === 'right') ? speed * 0.4 : -(speed * 0.4);

      var halfW = track.scrollWidth / 2;
      if(x <= -halfW) x = 0;
      if(x >= halfW)  x = 0;

      track.style.transform = 'translateX(' + x + 'px)';

      items.forEach(function(el, i){
        var wave = Math.sin(t + i * waveFreq) * waveAmp;
        el.style.transform = 'translateY(' + wave + 'px)';
      });
    }
    raf = requestAnimationFrame(tick);
  }

  tick();
})();
</script>

{% schema %}
{
  "name": "Wave Marquee",
  "tag": "section",
  "class": "section-wave-marquee",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e2e2e2"
    },
    {
      "type": "header",
      "content": "Wave effect"
    },
    {
      "type": "range",
      "id": "wave_amplitude",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Wave height (0 = flat)",
      "default": 6
    },
    {
      "type": "range",
      "id": "wave_frequency",
      "min": 1,
      "max": 20,
      "step": 1,
      "label": "Wave frequency (gap between peaks)",
      "default": 7
    },
    {
      "type": "header",
      "content": "Scroll"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 1,
      "max": 10,
      "step": 1,
      "label": "Scroll speed (1=slow, 10=fast)",
      "default": 3
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll direction",
      "options": [
        { "value": "left",  "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 15
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text case",
      "options": [
        { "value": "none",       "label": "Normal" },
        { "value": "uppercase",  "label": "UPPERCASE" },
        { "value": "lowercase",  "label": "lowercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Separator"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator symbol",
      "default": "✦",
      "info": "Examples: ✦  •  |  ★  ❯  /  —"
    },
    {
      "type": "range",
      "id": "separator_size",
      "min": 8,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Separator size",
      "default": 12
    },
    {
      "type": "header",
      "content": "Spacing & border"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 12
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Item spacing",
      "default": 28
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Border width",
      "default": 1
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 12,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Icon height",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "text_item",
      "name": "Text item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on orders over $50"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon (optional)"
        }
      ]
    },
    {
      "type": "image_item",
      "name": "Image only",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Alt text",
          "default": "Marquee image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wave Marquee",
      "blocks": [
        { "type": "text_item", "settings": { "text": "Tasty & Yummy" } },
        { "type": "text_item", "settings": { "text": "Healthy Drink" } },
        { "type": "text_item", "settings": { "text": "Budget Friendly" } },
        { "type": "text_item", "settings": { "text": "Home Delivery" } }
      ]
    }
  ]
}
{% endschema %}
